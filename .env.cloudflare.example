# Copy to .env.cloudflare (git-ignored) and fill in; used only by
# scripts/deploy.mjs (README, "Deploying"). Not .env: OpenNext would bake a
# root .env into the app bundle. Never commit the real file or paste it into
# chat.

# Cloudflare: My Profile > API Tokens > Create Token > "Edit Cloudflare
# Workers" (your account, zone udantravelsbdq.com). The account ID is in the
# dashboard URL.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Hosted Supabase: public values, built into the app and the connector.
PUBLIC_SUPABASE_URL=https://xczzvcrjarigejiekqgb.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Worker secrets. Empty values are skipped on deploy.
# Supabase > Project Settings > API Keys > Secret keys (starts sb_secret_).
SUPABASE_SECRET_KEY=
# Resend > API Keys. Empty: emails are logged instead of sent.
RESEND_API_KEY=
# Where customers' replies to Udan's emails go.
EMAIL_REPLY_TO=
# The business inbox: gets every desk alert (app and connector), plus any
# staff member with alerts switched on.
STAFF_ALERT_EMAIL=
# Optional prefills for the desk's payment-details email (quote multi-line text).
PAYMENT_DETAILS_BANK=
PAYMENT_DETAILS_UPI=
