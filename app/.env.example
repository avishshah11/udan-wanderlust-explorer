# app/.env.local for local development. Never commit real values.
# `pnpm --filter @udan/supabase start` prints the local URL and keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row level security; used for the public quote form,
# staff alert lookups and notification logs.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://udantravelsbdq.com
# Comma-separated origins allowed to post the website's Get a quote form.
QUOTE_FORM_ORIGINS=https://udantravelsbdq.com,https://www.udantravelsbdq.com,http://localhost:4321

# Transactional email (Resend). Without a key, emails are printed to the
# server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Udan Tours and Travels <quotes@udantravelsbdq.com>
EMAIL_REPLY_TO=
# Used only when no staff member has alerts switched on.
STAFF_ALERT_EMAIL=

# Optional prefills for the desk's "send payment details" form. Multi-line
# values need quotes. Leave blank to type them on the desk each time.
PAYMENT_DETAILS_BANK=
PAYMENT_DETAILS_UPI=
