{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "udan-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run next to the hosted Supabase project (AWS us-west-2, Oregon): each
  // tool call makes several database calls.
  "placement": { "region": "aws:us-west-2" },
  // The udantravelsbdq.com zone is on Cloudflare (21 Nov 2026); deploying
  // creates the DNS record and certificate for this custom domain.
  "routes": [{ "pattern": "mcp.udantravelsbdq.com", "custom_domain": true }],
  // The deploy workflow (.github/workflows/deploy.yml) replaces the two
  // Supabase values with the repository variables for the hosted project.
  "vars": {
    "SUPABASE_URL": "https://YOUR-PROJECT-REF.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
    "MCP_URL": "https://mcp.udantravelsbdq.com/mcp",
    "APP_URL": "https://app.udantravelsbdq.com",
    "DOCS_URL": "https://udantravelsbdq.com/connector",
    "EMAIL_FROM": "Udan Tours and Travels <quotes@udantravelsbdq.com>",
    "AUTH_MODE": "protected_tools"
  }
  // Secrets (wrangler secret put): RESEND_API_KEY, STAFF_ALERT_EMAIL, EMAIL_REPLY_TO
}
