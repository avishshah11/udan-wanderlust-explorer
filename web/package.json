{
  "name": "@udan/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/check-build.ts",
    "build:check": "astro build && tsx scripts/check-build.ts",
    "preview": "astro preview",
    "verify": "tsx scripts/verify-static.ts",
    "typecheck": "astro check && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "legacy:dev": "vite --config vite.legacy.config.ts",
