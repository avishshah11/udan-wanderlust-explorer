# Website build settings. Copy to web/.env for local builds; in GitHub Actions
# set them as repository variables (Settings > Secrets and variables > Actions >
# Variables). All three are public values.

# Where the Get a quote form posts.
PUBLIC_APP_URL=https://app.udantravelsbdq.com

# Read at build time for rate-card price ranges and exchange rates. Leave empty
# to build without prices. The publishable key is public (row level security
# limits it to published bands with 5+ quotes).
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
