---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist. Find destinations, visa services or ask Udan Tours and Travels for a quote." noindex>
  <section class="container mx-auto px-4 py-24 text-center md:px-6">
    <h1 class="text-4xl font-bold text-udan-charcoal">We couldn't find that page</h1>
    <p class="mx-auto mt-4 max-w-xl text-udan-gray">The link may be old. Here are the places most people are looking for:</p>
    <p class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-outline">Home</a>
      <a href="/packages" class="btn-outline">Destinations</a>
      <a href="/contact" class="btn-outline">Contact</a>
      <a href="/quote" class="btn-primary">Get a quote</a>
    </p>
  </section>
</Base>
