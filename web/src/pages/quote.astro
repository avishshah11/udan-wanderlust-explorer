---
import QuoteForm from "../components/QuoteForm.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Get a quote" description="Ask Udan Tours and Travels for a quote: tell us the trip, or send a price you have seen online. A member of our family prices it against our supplier rates and emails you the quote.">
  <section class="container mx-auto max-w-4xl px-4 py-12 md:px-6 md:py-16">
    <h1 class="text-3xl font-bold text-udan-charcoal md:text-4xl">Get a quote</h1>
    <p class="mb-10 mt-3 max-w-2xl text-udan-gray">
      Tell us what you have in mind; only the destination, dates and nights are needed. A member of our family prices it against our supplier rates, and your quote arrives in your inbox and in your Udan account, where you can accept it.
    </p>
    <QuoteForm />
  </section>
</Base>
