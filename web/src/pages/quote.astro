---
import QuoteForm from "../components/QuoteForm.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Get a quote" description="Ask Udan Tours and Travels for a quote on a holiday package, flights only or a hotel only, or send a price you have seen online. A member of our family prices it against our supplier rates and emails you the quote.">
  <section class="container mx-auto max-w-4xl px-4 py-12 md:px-6 md:py-16">
    <h1 class="text-3xl font-bold text-udan-charcoal md:text-4xl">Get a quote</h1>
    <p class="mb-10 mt-3 max-w-2xl text-udan-gray">
      Choose a whole holiday package, flights only or a hotel only, and tell us what you have in mind. A member of our family prices it against our supplier rates, and your quote arrives in your inbox and in your Udan account, where you can accept it.
      Asking costs nothing, and there is nothing to pay until you accept. <a class="text-udan-orange underline" href="/trust">How we work</a>.
    </p>
    <QuoteForm />
  </section>
</Base>
