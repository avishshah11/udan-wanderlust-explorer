---
const links = [
  { href: "/", label: "Home" },
  { href: "/packages", label: "Destinations" },
  { href: "/visa", label: "Visa" },
  { href: "/beat-my-price", label: "Beat my price" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const current = Astro.url.pathname.replace(/\.html$/, "");
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-white/95 backdrop-blur">
  <div class="container mx-auto flex h-16 items-center justify-between gap-4 px-4 md:h-20 md:px-6">
    <a href="/" class="shrink-0" aria-label="Udan Tours and Travels, home">
      <img src="/images/udan-logo.jpg" alt="Udan Tours and Travels" width="74" height="48" class="h-11 w-auto md:h-12" />
    </a>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={["font-medium transition-colors hover:text-udan-orange", current === l.href ? "text-udan-orange" : "text-udan-charcoal"]}
            aria-current={current === l.href ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-3">
      <a href="/quote" class="btn-primary px-4 py-2 text-sm md:px-6 md:text-base">Get a quote</a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-md p-2 text-udan-charcoal" aria-label="Menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </summary>
        <nav class="absolute right-0 mt-2 flex w-56 flex-col rounded-lg bg-white p-2 shadow-lg ring-1 ring-black/5" aria-label="Mobile">
          {links.map((l) => <a href={l.href} class="rounded px-3 py-2 text-udan-charcoal hover:bg-udan-lightGray">{l.label}</a>)}
          <a href={`https://app.udantravelsbdq.com/account`} class="rounded px-3 py-2 text-udan-charcoal hover:bg-udan-lightGray">My quotes</a>
        </nav>
      </details>
    </div>
  </div>
</header>
