---
import { SITE } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="bg-udan-charcoal pb-8 pt-14 text-white">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <img src="/images/udan-logo.jpg" alt="Udan Tours and Travels" width="98" height="64" class="h-16 w-auto rounded bg-white p-1" loading="lazy" />
        <p class="text-sm text-gray-300">A family travel agency in Vadodara. {SITE.foundedText}.</p>
        <a href="/quote" class="btn-primary">Get a quote</a>
      </div>
      <div class="space-y-3">
        <h2 class="text-lg font-semibold">Visit us</h2>
        <address class="text-sm not-italic leading-relaxed text-gray-300">
          {SITE.address.lines.map((l) => <>{l}<br /></>)}
        </address>
        <p class="text-sm text-gray-300">
          {SITE.hours.map((h) => <>{h.days}: {h.opens}–{h.closes}<br /></>)}
        </p>
      </div>
      <div class="space-y-3">
        <h2 class="text-lg font-semibold">Talk to us</h2>
        <ul class="space-y-2 text-sm text-gray-300">
          {SITE.phones.map((p) => <li>{p.label}: <a class="hover:text-udan-orange" href={`tel:${p.tel}`}>{p.display}</a></li>)}
          <li>Email: <a class="hover:text-udan-orange" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
      </div>
      <div class="space-y-3">
        <h2 class="text-lg font-semibold">More</h2>
        <nav class="flex flex-col gap-2 text-sm text-gray-300" aria-label="Footer">
          <a class="hover:text-udan-orange" href="/packages">Destinations</a>
          <a class="hover:text-udan-orange" href="/visa">Visa services</a>
          <a class="hover:text-udan-orange" href="/beat-my-price">Beat my price</a>
          <a class="hover:text-udan-orange" href="/connector">Udan in Claude</a>
          <a class="hover:text-udan-orange" href={`${SITE.appUrl}/account`}>My quotes</a>
          <a class="hover:text-udan-orange" href="/about">About us</a>
          <a class="hover:text-udan-orange" href="/trust">Why trust us</a>
          <a class="hover:text-udan-orange" href="/trust#pay-safely">Pay safely</a>
        </nav>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-3 border-t border-gray-700 pt-6 text-sm text-gray-400 md:flex-row md:justify-between">
      <p>© {year} {SITE.name}. {SITE.foundedText}.</p>
      <p class="flex gap-4">
        <a class="hover:text-udan-orange" href="/privacy">Privacy policy</a>
        <a class="hover:text-udan-orange" href="/terms">Terms and conditions</a>
      </p>
    </div>
  </div>
</footer>
